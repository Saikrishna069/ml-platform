# Real-World Free Production Environment Variables

# Database: Supabase PostgreSQL (Free 500MB)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Cache / Queue: Upstash Redis (Free 10,000 req/day)
REDIS_URL=rediss://default:[YOUR-UPSTASH-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# Security
SECRET_KEY=generate-a-secure-random-64-character-key
ALLOWED_ORIGINS=["https://ml-platform.vercel.app","http://localhost:5173"]
ENVIRONMENT=production

# GPU Acceleration (Optional: Hugging Face Inference API / Space URL)
HF_API_TOKEN=hf_your_free_huggingface_token
